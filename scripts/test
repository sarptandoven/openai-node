#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

function steady_is_running() {
  curl --silent --fail "http://127.0.0.1:4010/_x-steady/health" >/dev/null 2>&1
}

mock_pid_file=""

# Reports whether a process still runs. A stopped server whose parent never reaps it, such as an
# orphan under a container's init, remains a zombie that `kill -0` would still find.
mock_is_running() {
  local stat=""
  kill -0 "$1" 2>/dev/null || return 1
  # Linux reports the state after the parenthesized command name, even where ps is not installed.
  if [ -r "/proc/$1/stat" ]; then
    stat="$(cat "/proc/$1/stat" 2>/dev/null)" || stat=""
    stat="${stat##*) }"
  else
    stat="$(ps -o stat= -p "$1" 2>/dev/null)" || stat=""
  fi
  case "$stat" in
    Z*) return 1 ;;
  esac
}

# Runs a Windows command with MSYS argument conversion disabled, so that switches such as /PID reach
# it unchanged whatever MSYS_NO_PATHCONV or MSYS2_ARG_CONV_EXCL the caller has set.
windows_command() {
  MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' "$@"
}

# On Windows, node.exe never receives SIGTERM, so the launcher cannot forward it to Deno. Stop the
# whole native process tree by Windows PID instead. Windows reuses PIDs quickly, so first check that
# the PID still names a node.exe process.
stop_started_windows_mock() {
  local pid="$1" winpid="$2" process status
  process="$(windows_command tasklist /FI "PID eq $winpid" /FO CSV /NH 2>/dev/null)" || return 0
  case "$process" in
    '"node.exe",'* | '"NODE.EXE",'*) ;;
    *) return 0 ;;
  esac
  if windows_command taskkill /PID "$winpid" /T /F >/dev/null 2>&1; then
    echo "Stopped $pid."
  else
    status=$?
    echo -e "${YELLOW}WARNING:${NC} Could not stop the mock server started by this run (Windows PID $winpid, taskkill status $status)." >&2
  fi
}

# Stops the mock server that this run started, using the PIDs its launcher recorded rather than
# a port lookup tool such as lsof, which some hosts lack.
stop_started_mock() {
  local pid="" winpid="" attempt
  if [ -s "$mock_pid_file" ]; then
    { read -r pid || true; read -r winpid || true; } < "$mock_pid_file"
  fi
  rm -f "$mock_pid_file"
  # Only a positive PID names one process; `kill 0` would signal this whole process group.
  case "$pid" in
    "" | 0* | *[!0-9]*) return ;;
  esac
  case "$winpid" in
    0* | *[!0-9]*) winpid="" ;;
  esac
  # A launcher interrupted during startup has not recorded the Windows PID yet. Git Bash can still
  # map the server's PID to one while the server runs.
  if [ -z "$winpid" ] && [ -r "/proc/$pid/winpid" ]; then
    winpid="$(cat "/proc/$pid/winpid" 2>/dev/null)" || winpid=""
  fi
  if [ -n "$winpid" ] && command -v taskkill >/dev/null 2>&1; then
    stop_started_windows_mock "$pid" "$winpid"
    return
  fi

  mock_is_running "$pid" || return 0
  kill "$pid" 2>/dev/null || true
  for ((attempt = 0; attempt < 50; attempt++)); do
    if ! mock_is_running "$pid"; then
      echo "Stopped $pid."
      return
    fi
    sleep 0.1
  done
  echo -e "${YELLOW}WARNING:${NC} The mock server started by this run (PID $pid) is still running." >&2
}

function is_overriding_api_base_url() {
  [ -n "$TEST_API_BASE_URL" ]
}

function has_jest_worker_flag() {
  for arg in "$@"; do
    case "$arg" in
      --runInBand|--runInBand=*|--run-in-band|--run-in-band=*|-i)
        return 0
        ;;
      --maxWorkers|--maxWorkers=*|--max-workers|--max-workers=*|-w|-w?*)
        return 0
        ;;
    esac
  done

  return 1
}

generated_test_patterns=()
while IFS= read -r generated_test_pattern; do
  generated_test_patterns+=("$generated_test_pattern")
done < <(node -e 'for (const pattern of require("./scripts/generated-test-patterns.json")) console.log(pattern)')

function is_generated_test_path() {
  local test_path="$1"
  local generated_test_pattern

  for generated_test_pattern in "${generated_test_patterns[@]}"; do
    case "$test_path" in
      "$generated_test_pattern"|"$generated_test_pattern"/*|*/"$generated_test_pattern"|*/"$generated_test_pattern"/*)
        return 0
        ;;
    esac
  done

  return 1
}

test_suite="${OPENAI_TEST_SUITE:-all}"
vitest_args=()
jest_args=()
has_unit_filter=false
has_generated_filter=false
args=("$@")

for ((index = 0; index < ${#args[@]}; index++)); do
  arg="${args[index]}"

  case "$arg" in
    --)
      ;;
    tests/*|./tests/*|*/tests/*)
      if is_generated_test_path "$arg"; then
        has_generated_filter=true
        jest_args+=("$arg")
      else
        has_unit_filter=true
        vitest_args+=("$arg")
      fi
      ;;
    --runInBand|--runInBand=*|--run-in-band|--run-in-band=*|-i|--showConfig)
      jest_args+=("$arg")
      ;;
    --maxWorkers|--max-workers|-w)
      jest_args+=("$arg")
      vitest_args+=(--maxWorkers)
      if ((index + 1 < ${#args[@]})); then
        ((index += 1))
        jest_args+=("${args[index]}")
        vitest_args+=("${args[index]}")
      fi
      ;;
    --maxWorkers=*|--max-workers=*)
      jest_args+=("$arg")
      vitest_args+=("--maxWorkers=${arg#*=}")
      ;;
    -w?*)
      jest_args+=("$arg")
      worker_count="${arg#-w}"
      vitest_args+=("--maxWorkers=${worker_count#=}")
      ;;
    *)
      vitest_args+=("$arg")
      jest_args+=("$arg")
      ;;
  esac
done

case "$test_suite" in
  unit)
    echo "==> Running handwritten unit tests"
    exec ./node_modules/.bin/vitest run --config vitest.config.mts "${vitest_args[@]}"
    ;;
  all)
    if ! $has_generated_filter || $has_unit_filter; then
      echo "==> Running handwritten unit tests"
      ./node_modules/.bin/vitest run --config vitest.config.mts "${vitest_args[@]}"
    fi

    if $has_unit_filter && ! $has_generated_filter; then
      exit 0
    fi
    ;;
  generated)
    ;;
  *)
    echo "ERROR: Unknown OPENAI_TEST_SUITE: ${OPENAI_TEST_SUITE}. Expected all, generated, or unit." >&2
    exit 1
    ;;
esac

if ! is_overriding_api_base_url && ! steady_is_running ; then
  mock_pid_file="$(mktemp "${TMPDIR:-/tmp}/openai-mock-pid.XXXXXX")"
  # When we exit this script, make sure to stop the mock server it started
  trap stop_started_mock EXIT

  # Start the dev server
  OPENAI_MOCK_PID_FILE="$mock_pid_file" ./scripts/mock --daemon || {
    mock_status=$?
    # The launcher cleans up ordinary startup failures. Signals may skip its trap.
    if [ "$mock_status" -le 128 ]; then
      trap - EXIT
      rm -f "$mock_pid_file"
    fi
    exit "$mock_status"
  }
fi

if is_overriding_api_base_url ; then
  echo -e "${GREEN}✔ Running tests against ${TEST_API_BASE_URL}${NC}"
  echo
elif ! steady_is_running ; then
  echo -e "${RED}ERROR:${NC} The test suite will not run without a mock Steady server"
  echo -e "running against your OpenAPI spec."
  echo
  echo -e "To run the server, pass in the path or url of your OpenAPI"
  echo -e "spec to the steady command:"
  echo
  echo -e "  \$ ${YELLOW}./scripts/run-steady path/to/your.openapi.yml --host 127.0.0.1 -p 4010 --validator-query-array-format=brackets --validator-form-array-format=brackets --validator-query-object-format=brackets --validator-form-object-format=brackets${NC}"
  echo

  exit 1
else
  echo -e "${GREEN}✔ Mock steady server is running with your OpenAPI spec${NC}"
  echo
fi

echo "==> Running generated tests"

if ! is_overriding_api_base_url && ! has_jest_worker_flag "${jest_args[@]}"; then
  # The local Steady mock server is occasionally flaky under Jest's parallel
  # workers, especially for multipart requests. Keep the default harness stable
  # while allowing callers to opt into explicit worker settings.
  jest_args=(--runInBand "${jest_args[@]}")
fi

OPENAI_TEST_SUITE=generated ./node_modules/.bin/jest "${jest_args[@]}"
